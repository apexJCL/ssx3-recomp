# Written by `xbr new`. Game data, generated code, the toolchain and the
# bundles never enter git.

# Your dump, and the analysis the pipeline writes beside it; `import`
# builds the dump beside it first and keeps the old one there until the
# new one is in place.
game_files/
game_files.partial/
game_files.old/

# Generated code and its key (`ssx3 package` regenerates when it differs).
src/recomp/gen/
src/recomp/gen.key.json
src/recomp/.gen-regenerating

# The pipeline's intermediates.
analysis/

# Builds, and the packaging build trees.
build-win/
build/
build-*/
build-logs/

# `ssx3 setup`: the pinned venv, the toolchain, the toolkit and CLI clones.
.venv/
.venv-ghidra/
third_party/
external/
.xbr-pin

# `ssx3 package`: private bundles holding the game. Never commit them.
dist/
*.dmg
*.exe
*.pdb
*.nsi
*.tar

# The bench host.
bench-logs/
scripts/bench.env

# Game data, captures and game output, anywhere in the tree.
*.xbe
*.iso
*.xiso
*.xpr
*.xwb
*.adx
*.sfd
*.ipk
*.wav
*.bmp
*.png
# Screenshots of your own build for the README are the one exception.
!docs/images/*.png
*.ico
*.icns
*.ppm
*.raw
*.sav
*.xsv
UDATA/
TDATA/
saves/

*.pack
hud-pack.toml
*.xmv
*.rws
*.awd
CACHE/

# Work that belongs outside the repo: worktrees live in the workspace's
# wt/ (doctor still reports one here), A/B and probe output in its runs/.
/wt/
_local/
runs/

# Backups: a tracked game.toml.bak-<date> is how one gets in.
*.bak
*.bak-*

# Per-user agent settings.
.claude/settings.local.json
CLAUDE.local.md

*.log
__pycache__/
.ruff_cache/
.DS_Store

# --- this game ---
